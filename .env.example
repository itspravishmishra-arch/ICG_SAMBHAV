# Copy this file to ".env" and fill in your values. Never commit ".env".

# ---- Which AI service to use: openai, gemini or ollama ----
LLM_PROVIDER=gemini

# OpenAI (needs an account with credit): https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Google Gemini (has a free tier): pip install langchain-google-genai
# Free key: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-key

# Ollama (runs on your own computer, free, no key): pip install langchain-ollama
# OLLAMA_BASE_URL=http://localhost:11434

# ---- The database to ask questions about ----
# Sample database made by create_sample_db.py:
DATABASE_URL=sqlite:///sample_shop.db
# PostgreSQL example (needs: pip install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ---- Optional: choose models (use names that belong to the provider above) ----
# Run: python rag_sql_chatbot.py --list-models   to see what you can use
# CHAT_MODEL=
# EMBEDDING_MODEL=
# OKF_MODEL=
